<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== COLOR PALETTE ==================== -->
    <Color x:Key="CrtBlack">#07090C</Color>
    <Color x:Key="CrtSurface">#12161B</Color>
    <Color x:Key="CrtElevated">#191F26</Color>
    <Color x:Key="CrtBorder">#2A343A</Color>

    <Color x:Key="PhosphorWhite">#EBEFF1</Color>
    <Color x:Key="PhosphorDim">#8B979C</Color>
    <Color x:Key="PhosphorDark">#58646A</Color>

    <Color x:Key="AmberAlert">#52CD9E</Color>
    <Color x:Key="AmberDim">#246C57</Color>
    <Color x:Key="HazardRed">#DA6060</Color>
    <Color x:Key="TerminalGreen">#52CD9E</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="CrtBlackBrush" Color="{StaticResource CrtBlack}"/>
    <SolidColorBrush x:Key="CrtSurfaceBrush" Color="{StaticResource CrtSurface}"/>
    <SolidColorBrush x:Key="CrtElevatedBrush" Color="{StaticResource CrtElevated}"/>
    <SolidColorBrush x:Key="CrtBorderBrush" Color="{StaticResource CrtBorder}"/>
    <SolidColorBrush x:Key="PhosphorWhiteBrush" Color="{StaticResource PhosphorWhite}"/>
    <SolidColorBrush x:Key="PhosphorDimBrush" Color="{StaticResource PhosphorDim}"/>
    <SolidColorBrush x:Key="PhosphorDarkBrush" Color="{StaticResource PhosphorDark}"/>
    <SolidColorBrush x:Key="AmberAlertBrush" Color="{StaticResource AmberAlert}"/>
    <SolidColorBrush x:Key="AmberDimBrush" Color="{StaticResource AmberDim}"/>
    <SolidColorBrush x:Key="HazardRedBrush" Color="{StaticResource HazardRed}"/>
    <SolidColorBrush x:Key="TerminalGreenBrush" Color="{StaticResource TerminalGreen}"/>

    <!-- ==================== TYPOGRAPHY ==================== -->
    <FontFamily x:Key="FontMono">Consolas, Courier New</FontFamily>
    <FontFamily x:Key="FontUi">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI, Microsoft YaHei UI</FontFamily>

    <!-- ==================== TACTICAL BUTTON STYLE ==================== -->
    <Style x:Key="TacticalButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PhosphorWhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PhosphorDimBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="content"
                                      Text="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource CrtElevatedBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PhosphorWhiteBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource CrtSurfaceBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PRIMARY BUTTON (Amber) -->
    <Style x:Key="TacticalButtonPrimary" TargetType="Button" BasedOn="{StaticResource TacticalButton}">
        <Setter Property="BorderBrush" Value="{StaticResource AmberAlertBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AmberAlertBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <TextBlock Text="{TemplateBinding Content}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource AmberAlertBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource CrtBlackBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TacticalButtonActive" TargetType="Button" BasedOn="{StaticResource TacticalButtonPrimary}">
        <Setter Property="Background" Value="{StaticResource AmberAlertBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CrtBlackBrush}"/>
    </Style>

    <!-- DANGER BUTTON (Red) -->
    <Style x:Key="TacticalButtonDanger" TargetType="Button" BasedOn="{StaticResource TacticalButton}">
        <Setter Property="BorderBrush" Value="{StaticResource HazardRedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource HazardRedBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <TextBlock Text="{TemplateBinding Content}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource HazardRedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PhosphorWhiteBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== TACTICAL COMBOBOX STYLE ==================== -->
    <Style x:Key="TacticalComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource CrtBlackBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PhosphorWhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CrtBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="16,0,10,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PART_ToggleButton"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="{TemplateBinding Background}"
                                      Foreground="{TemplateBinding Foreground}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Focusable="False"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              Margin="16,0,8,0"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="▾"
                                                       Foreground="{StaticResource PhosphorDimBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       FontFamily="{StaticResource FontUi}"
                                                       FontSize="13"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AmberAlertBrush}"/>
                                            <Setter TargetName="border" Property="Background" Value="{StaticResource CrtElevatedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               StaysOpen="False"
                               PopupAnimation="Slide">
                            <Border Background="{StaticResource CrtSurfaceBrush}"
                                    BorderBrush="{StaticResource AmberAlertBrush}"
                                    BorderThickness="2"
                                    MaxHeight="300"
                                    Width="{Binding ActualWidth, ElementName=PART_ToggleButton}">
                                <ScrollViewer CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="{StaticResource CrtSurfaceBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource PhosphorWhiteBrush}"/>
                    <Setter Property="Padding" Value="16,9"/>
                    <Setter Property="MinHeight" Value="38"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="itemBorder"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource CrtElevatedBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AmberAlertBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource AmberDimBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource CrtElevatedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AmberAlertBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== TACTICAL SLIDER STYLE ==================== -->
    <Style x:Key="TacticalSlider" TargetType="Slider">
        <Setter Property="Background" Value="{StaticResource CrtBlackBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AmberAlertBrush}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid MinHeight="40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="12"/>
                        </Grid.RowDefinitions>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource CrtBorderBrush}"
                                BorderThickness="1"
                                Height="8"
                                VerticalAlignment="Center"
                                Margin="8,0,8,0"
                                Grid.Row="0"/>
                        <Track x:Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                               Margin="8,0"
                               Grid.Row="0"
                               VerticalAlignment="Center"
                               Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              IsTabStop="False"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{StaticResource AmberDimBrush}" Height="6"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              IsTabStop="False"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{StaticResource CrtBorderBrush}" Height="6"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="22" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="thumb"
                                                    Background="{StaticResource CrtSurfaceBrush}"
                                                    BorderBrush="{StaticResource AmberAlertBrush}"
                                                    BorderThickness="2"
                                                    CornerRadius="0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumb" Property="Background" Value="{StaticResource AmberAlertBrush}"/>
                                                    <Setter TargetName="thumb" Property="BorderBrush" Value="{StaticResource PhosphorWhiteBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}}"
                                   FontFamily="{StaticResource FontMono}" FontSize="9"
                                   Foreground="{StaticResource PhosphorDimBrush}"
                                   HorizontalAlignment="Left" Margin="8,0,0,0"/>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}}"
                                   FontFamily="{StaticResource FontMono}" FontSize="9"
                                   Foreground="{StaticResource PhosphorDimBrush}"
                                   HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TacticalScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent" BorderThickness="0" IsTabStop="False" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Margin="2,1" Background="{StaticResource CrtBorderBrush}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="thumb" Background="{TemplateBinding Background}" CornerRadius="2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumb" Property="Background" Value="{StaticResource AmberDimBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent" BorderThickness="0" IsTabStop="False" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TacticalCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource PhosphorWhiteBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="box" Width="16" Height="16" Margin="0,0,8,0"
                                Background="{StaticResource CrtBlackBrush}"
                                BorderBrush="{StaticResource CrtBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="mark" Text="✓" FontFamily="{StaticResource FontUi}"
                                       FontSize="12" FontWeight="Bold" Foreground="{StaticResource AmberAlertBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AmberAlertBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource CrtElevatedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== TEXTBLOCK STYLES ==================== -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource PhosphorWhiteBrush}"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="ParamLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource PhosphorWhiteBrush}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="120"/>
        <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
    </Style>

    <Style x:Key="ParamValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource AmberAlertBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="MetricLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource PhosphorDimBrush}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource PhosphorWhiteBrush}"/>
        <Setter Property="Background" Value="{StaticResource CrtElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AmberAlertBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource AmberAlertBrush}"/>
    </Style>

    <!-- ==================== PANEL STYLES ==================== -->
    <Style x:Key="TacticalPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CrtSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CrtBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

</ResourceDictionary>
